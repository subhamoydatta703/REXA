{
  "name": "rexa-agent",
  "version": "1.0.4",
  "description": "REXA — a general-purpose, single-agent development harness that understands tasks, gathers context, plans solutions, writes code, runs checks, and reports results through one continuous conversation.",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "type": "module",
  "license": "MIT",
  "author": "Subhamoy Datta",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subhamoydatta703/REXA.git"
  },
  "homepage": "https://github.com/subhamoydatta703/REXA#readme",
  "bugs": {
    "url": "https://github.com/subhamoydatta703/REXA/issues"
  },
  "keywords": [
    "ai-agent",
    "cli",
    "gemini",
    "autonomous-coding",
    "agent-harness",
    "guardrails",
    "sandboxing",
    "bun",
    "developer-tools",
    "rexa"
  ],
  "engines": {
    "bun": ">=1.1",
    "node": ">=18"
  },
  "files": [
    "src/",
    "LICENSE",
    "README.md",
    "package.json",
    "tsconfig.json",
    "docker-compose.yaml",
    "sandbox.Dockerfile"
  ],
  "scripts": {
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "bun x tsc --noEmit -p tsconfig.json",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "rexa": "bun run src/index.ts"
  },
  "bin": {
    "rexa": "src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/figlet": "^1.7.0",
    "@types/gradient-string": "^1.1.6",
    "@types/react": "^19.2.18"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@inquirer/prompts": "^8.7.0",
    "@tavily/core": "^0.7.7",
    "chalk": "^6.0.0",
    "cli-highlight": "^2.1.11",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "figlet": "^1.11.4",
    "gradient-string": "^3.0.0",
    "ink": "^7.1.1",
    "keytar": "^7.9.0",
    "marked": "^18.0.11",
    "marked-terminal": "^7.3.0",
    "ora": "^9.4.1",
    "react": "^19.2.8",
    "replace-in-file": "^9.0.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  }
}
