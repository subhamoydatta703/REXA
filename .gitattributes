# Normalize line endings (Windows dev, Linux CI)
* text=auto eol=lf

# Lock files
bun.lock linguist-generated=false

# Prisma 8 — emitted contract artifacts (regenerated by `prisma contract emit`)
src/prisma/contract.json linguist-generated
src/prisma/contract.d.ts linguist-generated

# Prisma 8 — inferred contract stub (from `prisma contract infer`, if present)
prisma/contract.prisma linguist-generated

# Prisma 8 — migration package artifacts (regenerated by the migration toolchain)
migrations/*/migration.json linguist-generated
migrations/*/ops.json linguist-generated
migrations/*/*-contract.json linguist-generated
migrations/snapshots/**/contract.json linguist-generated
migrations/snapshots/**/contract.d.ts linguist-generated
