# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Optional: extract LinkedIn personal profiles via Bright Data's LinkedIn Profiles scraper.
# Use an account API token from Bright Data Settings > Users/API keys.
# Playwright/Selenium connection URLs and Browser API zone credentials do not work here.
# This variable overrides the token saved by the CLI; update or remove it when rotating tokens.
# Prefer the masked prompt: bun run src/index.ts config set-brightdata-key
# BRIGHTDATA_API_KEY="your-bright-data-account-api-token"
